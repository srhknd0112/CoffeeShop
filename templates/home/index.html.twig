
{% extends 'base.html.twig' %}

{% block title %}Accueil - Coffee Shop{% endblock %}

{% block body %}

    <section class="slider">
        <div class="container">
            {% if slider %}
                <h1>{{ slider.title }}</h1>
                <p>{{ slider.content }}</p>

                {% if slider.buttonText and slider.buttonLink %}
                    <a href="{{ slider.buttonLink }}" class="btn">
                        {{ slider.buttonText }}
                    </a>
                {% endif %}
            {% else %}
                <h1>Bienvenue chez Coffee Shop</h1>
                <p>Découvrez nos cafés.</p>
            {% endif %}
        </div>
    </section>

    <section class="apropos">
        <div class="container">
            <h2>A propos de nous</h2>
            <p>Depuis plus de dix ans, nous choisissons nos cafés directement auprès des producteurs. Chaque lot est goûté, torréfié et préparé dans notre atelier. Notre but est simple : vous faire découvrir des cafés de qualité, avec des saveurs différentes selon leur origine.</p>
        </div>
    </section>

    <section>
        <div class="container">
            <h2>Cafés en tendance</h2>
            <div class="grille">
                {% for produit in produits %}
                    {{ include('produit/_card.html.twig', {produit: produit}) }}
                {% else %}
                    <p>Aucun produit pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="temoignages">
        <div class="container">
            <h2>Ils nous font confiance</h2>
            <div class="grille">
                <div class="avis">
                    <p>"Le meilleur café que j'ai goûté, je commande chaque mois."</p>
                    <span>Marie D.</span>
                </div>
                <div class="avis">
                    <p>"Des saveurs très différentes selon les origines, j'adore."</p>
                    <span>Thomas L.</span>
                </div>
                <div class="avis">
                    <p>"Equipe accueillante et conseils très utiles pour choisir."</p>
                    <span>Sarah B.</span>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
