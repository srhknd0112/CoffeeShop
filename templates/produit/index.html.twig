{% extends 'base.html.twig' %}

{% block title %}Nos produits - Coffee Shop{% endblock %}

{% block body %}

    <section>
        <div class="container">
            <h2>Nos produits</h2>

            <form class="filtre" method="get" action="{{ path('app_produit') }}">
                <div>
                    <label for="marque">Marque</label>
                    <select name="marque" id="marque">
                        <option value="">Toutes</option>
                        <option value="Lavazza">Lavazza</option>
                        <option value="Illy">Illy</option>
                        <option value="Malongo">Malongo</option>
                    </select>
                </div>
                <div>
                    <label for="categorie">Catégorie</label>
                    <select name="categorie" id="categorie">
                        <option value="">Toutes</option>
                        <option value="Grains">Grains</option>
                        <option value="Moulu">Moulu</option>
                        <option value="Capsules">Capsules</option>
                    </select>
                </div>
                <div>
                    <label for="prix_max">Prix maximum (€)</label>
                    <input type="number" name="prix_max" id="prix_max" min="0">
                </div>
                <button type="submit" class="btn">Filtrer</button>
            </form>

            <div class="grille">
               {% for produit in produits %}
                    {{ include('produit/_card.html.twig', {produit: produit}) }}
                {% else %}
                    <p>Aucun produit pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}