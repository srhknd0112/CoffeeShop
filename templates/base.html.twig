<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Coffee Shop{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>

    <header>
        <div class="container nav">
            <a href="{{ path('app_home') }}" class="logo">Coffee Shop</a>
            <nav>
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_produit') }}">Nos produits</a></li>
                    <li><a href="{{ path('app_contact') }}">Nous contacter</a></li>
                </ul>
            </nav>
        </div>
    </header>

    {% block body %}{% endblock %}

    <footer>
        <div class="container">
            <p><strong>Coffee Shop</strong></p>
            <p>12 rue du Café, 75000 Paris</p>
            <p>01 02 03 04 05 · contact@coffeeshop.fr</p>
        </div>
    </footer>

</body>
</html>
